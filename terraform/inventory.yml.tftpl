# Generated by Terraform (terraform/outputs.tf). Don't edit: run `make up` again.
all:
  vars:
    ansible_user: lab
  children:
%{ for group in distinct(flatten([for vm in values(vms) : vm.groups])) ~}
    ${group}:
      hosts:
%{ for name, vm in vms ~}
%{ if contains(vm.groups, group) ~}
        ${names[name]}:
          ansible_host: ${ips[name] == null ? "UNKNOWN" : ips[name]}
          pve_vm_id: ${vm_ids[name]}
%{ endif ~}
%{ endfor ~}
%{ endfor ~}
